{
  "extends": "@tsconfig/recommended",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": true,
    "strictPropertyInitialization": false,
    "allowJs": true,
    "strict": true,
    "strictFunctionTypes": false,
    "noEmit": true,
    "types": ["jest", "node"],
    "resolveJsonModule": true,
    "paths": {
      "@platform/common": ["./packages/common/src/index.ts"],
      "@platform/common/*": ["./packages/common/src/*"],
      "@platform/contracts": ["./packages/contracts/src/index.ts"],
      "@platform/database": ["./packages/database/src/index.ts"],
      "@platform/vector-store": ["./packages/vector-store/src/index.ts"],
      "@platform/llm": ["./packages/llm/src/index.ts"],
      "@platform/market-data": ["./packages/market-data/src/index.ts"],
      "@platform/broker": ["./packages/broker/src/index.ts"],
      "@platform/shared-state": ["./packages/shared-state/src/index.ts"],
      "@platform/risk": ["./packages/risk/src/index.ts"],
      "@platform/observability": ["./packages/observability/src/index.ts"],
      "@platform/research-agent": ["./agents/research-agent/src/index.ts"],
      "@platform/execution-agent": ["./agents/execution-agent/src/index.ts"],
      "@platform/supervisor": ["./agents/supervisor/src/index.ts"],
      "@platform/news-ingestion": ["./apps/news-ingestion/src/index.ts"],
      "@platform/trade-executor": ["./apps/trade-executor/src/index.ts"],
      "@platform/api-gateway": ["./apps/api-gateway/src/index.ts"],
      "@platform/agent-server": ["./apps/agent-server/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
