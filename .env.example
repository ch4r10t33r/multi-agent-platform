# Paper trading is the only mode this scaffold will start.
TRADING_MODE=paper

# News assessment. lexicon is the offline default and needs no model server.
# ANALYST_PROVIDER=sglang uses constrained decoding only when nvidia-smi lists a GPU.
# With no NVIDIA GPU, assessment stays on the lexicon even if this is set to sglang.
# ANALYST_PROVIDER=sglang
# SGLANG_BASE_URL=http://127.0.0.1:30000/v1
# SGLANG_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# GPU host:
# docker compose --profile sglang \
#   -f infrastructure/docker/docker-compose.yml \
#   -f infrastructure/docker/docker-compose.gpu.yml up sglang

# Used only when ANALYST_PROVIDER=openai, and for OpenAI embeddings.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# fixture uses the bundled feed. yahoo calls an unofficial Yahoo Finance endpoint.
# Review Yahoo's terms, rate limits, and retention rules before using it.
NEWS_PROVIDER=fixture
QUOTE_PROVIDER=fixture

# Uncomment after `docker compose -f infrastructure/docker/docker-compose.yml up -d`.
# DATABASE_URL=postgres://platform:platform@localhost:5432/platform
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

PORT=3000
LOG_LEVEL=info
EMBEDDING_DIMENSIONS=64

# Optional LangSmith tracing for the LangGraph server.
# LANGSMITH_API_KEY=
