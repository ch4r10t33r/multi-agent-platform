{
  "name": "multi-agent-platform",
  "version": "0.0.1",
  "description": "Event-driven financial research and paper-trade execution platform.",
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "dev:api": "tsx apps/api-gateway/src/index.ts",
    "ingest:once": "tsx apps/news-ingestion/src/worker.ts --once",
    "reconcile": "tsx apps/trade-executor/src/reconciliation.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=\\.test\\.ts$ --testPathIgnorePatterns=\\.int\\.test\\.ts$",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=\\.int\\.test\\.ts$",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "lint:langgraph-json": "node scripts/checkLanggraphPaths.js",
    "lint:all": "pnpm lint && pnpm lint:langgraph-json && pnpm format:check",
    "test:all": "pnpm test && pnpm test:int && pnpm lint:all"
  },
  "dependencies": {
    "@platform/agent-server": "workspace:*",
    "@platform/api-gateway": "workspace:*",
    "@platform/broker": "workspace:*",
    "@platform/common": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/database": "workspace:*",
    "@platform/execution-agent": "workspace:*",
    "@platform/llm": "workspace:*",
    "@platform/market-data": "workspace:*",
    "@platform/news-ingestion": "workspace:*",
    "@platform/observability": "workspace:*",
    "@platform/research-agent": "workspace:*",
    "@platform/risk": "workspace:*",
    "@platform/shared-state": "workspace:*",
    "@platform/supervisor": "workspace:*",
    "@platform/trade-executor": "workspace:*",
    "@platform/vector-store": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@tsconfig/recommended": "^1.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.6",
    "turbo": "^2.11.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.6.7"
  }
}
